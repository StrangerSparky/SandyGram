[Desktop Entry]
Name=SandyGram Desktop
Comment=Desktop version of SandyGram - ToS breaking Telegram client
TryExec=SandyGram
Exec=env DESKTOPINTEGRATION=1 SandyGram -- %U
Icon=com.sandygram.desktop
Terminal=false
StartupWMClass=SandyGram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=tg;chat;im;messaging;messenger;sms;telegram;tdesktop;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=SandyGram -quit
Name=Quit SandyGram
Icon=application-exit
